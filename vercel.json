{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate",
  "outputDirectory": ".",
  "regions": ["lhr1"],
  "crons": [
    {"path": "/api/cron/fixtures", "schedule": "30 5 * * *"},
    {"path": "/api/cron/predictions", "schedule": "0 8 * * 3"},
    {"path": "/api/cron/predictions", "schedule": "0 9 * * 3"},
    {"path": "/api/cron/predictions", "schedule": "0 7 * * 4"},
    {"path": "/api/cron/predictions", "schedule": "0 8 * * 4"}
  ],
  "functions": {
    "api/cron/fixtures.mjs": {"maxDuration": 60},
    "api/cron/predictions.mjs": {"maxDuration": 300}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https://resources.premierleague.com; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"}
      ]
    }
  ]
}
