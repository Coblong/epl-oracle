AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
OPENAI_API_KEY=your_openai_project_key
# Set automatically once a Blob store is connected to this Vercel project (`vercel env pull` fetches it locally).
BLOB_READ_WRITE_TOKEN=
# Use Neon's pooled connection string. Keep SSL verification enabled.
DATABASE_URL=
# Explicit cutover after a verified import. Default is blob; use neon after migration.
PERSISTENCE_BACKEND=blob
# Optional isolated schema for database tests/previews. Default: epl_oracle.
# DATABASE_SCHEMA=epl_oracle
# Optional: set this and Vercel sends it back as a Bearer token on every Cron Jobs request, so /api/cron/* can verify the caller.
CRON_SECRET=
