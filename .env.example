AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
# Set automatically once a Blob store is connected to this Vercel project (`vercel env pull` fetches it locally).
BLOB_READ_WRITE_TOKEN=
# Optional: set this and Vercel sends it back as a Bearer token on every Cron Jobs request, so /api/cron/* can verify the caller.
CRON_SECRET=
